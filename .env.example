# Local credentials only. Do not commit .env.
GITHUB_TOKEN=
KEENABLE_API_KEY=
EXA_API_KEY=
ANTHROPIC_API_KEY=
# Optional: defaults to ANTHROPIC_API_KEY during run-all.
MARTIAN_API_KEY=
# Generated once by run-all if empty.
MCP_SEARCH_A_TOKEN=
MCP_SEARCH_B_TOKEN=

# Local gateway port; change if another application uses it.
MCP_HOST_PORT=8766

# Optional stable HTTPS origin. Empty starts a temporary Cloudflare tunnel.
PUBLIC_MCP_URL=
